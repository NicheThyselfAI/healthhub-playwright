# Environment variables for HealthHub Docker Compose
# Copy this file to .env and modify as needed

# Application Settings
NODE_ENV=production
JWT_SECRET=your-super-secure-jwt-secret-here-2024
CORS_ORIGIN=http://localhost

# Feature Flags
APPOINTMENTS_FEATURE_FLAG=enabled

# Database Settings (if using external DB)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=healthhub
# DB_USER=healthhub_user
# DB_PASSWORD=secure_password

# Ports (override defaults if needed)
# BACKEND_PORT=3001
# FRONTEND_PORT=80

# Testing Configuration
CI=false
TEST_ENV=docker
BASE_URL=http://localhost
API_URL=http://localhost:3001

# Development Settings
VITE_API_URL=http://localhost:3001
