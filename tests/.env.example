# HealthHub Playwright Test Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Test credentials (REQUIRED)
TEST_EMAIL=your-test-email@example.com
TEST_PASSWORD=your-test-password

# API configuration
API_BASE_URL=http://localhost:3001/api/v1

# Base URL for the frontend app (overrides playwright.config.js)
# BASE_URL=http://localhost:5173

# Feature flags
ENABLE_EXPERIMENTAL=false

# External service availability (set to false to skip API-dependent tests)
API_AVAILABLE=true
